# perform_t_test() samples from the current group_a and group_b (the heights)
sample_sizes = [30, 50, 100, 200, 400, 1000, 2000]
p_values = [perform_t_test(size)[1] for size in sample_sizes]

plt.figure(figsize=(10, 6))
plt.plot(sample_sizes, p_values, marker='o')
plt.axhline(y=0.05, color='r', linestyle='--', label='Significance Level (0.05)')
plt.xscale('log')
plt.xlabel('Sample Size')
plt.ylabel('p-value')
plt.ylim(0, 1)
plt.title('Impact of Sample Size on Statistical Significance')
plt.legend()
plt.grid(True)
plt.show()

for size, p_value in zip(sample_sizes, p_values):
    print(f"Sample Size: {size}, p-value: {p_value:.4f}")
